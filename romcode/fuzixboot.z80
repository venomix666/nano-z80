; Fuzix boot routines for the nano-z80

; Boot fuzix from SD-card
fuzix_boot:
        ; Copy fuzix boot code from ROM to high RAM
        ld hl, fuzix_boot_rom
        ld de, fuzix_boot_ram
        ld bc, fuzix_boot_size
        ldir

        ; Jump to the code in high RAM
        jp fuzix_boot_start

        .phase 0xfe00
; Fuzix boot - all the code below here will be moved to 0xfe00
; Read boot sector and boot from sd card
fuzix_boot_rom = $$
fuzix_boot_ram = $

fuzix_boot_start:
        ; Disable interrupts
        di

        ; Disable the ROM
        ld a, 0x01
        out (ROM_DISABLE), a

        ; Set hardcoded Fuzix kernel sector on SD card
        call fuzix_sd_init
        ld a, 0x00
        ld (SD_ADDR_BUF),a
        ld a, 0x10
        ld (SD_ADDR_BUF+1),a
        ld a, 0x00
        ld (SD_ADDR_BUF+2),a
        ld a, 0x02
        ld (SD_ADDR_BUF+3),a
        
        ; Set number of pages
        ld a, 126 ; 126*512 -> 64512 bytes maximum kernel size
        ld (PAGE_CNT), a

        ; Set store address to 0x0000
        ld h,0
        ld l,0

        ; Perform read
        call fuzix_sd_boot_loop

        ; Jump to Kernel init code
        jp 0x0088 

fuzix_sd_boot_loop:
        ld a, (SD_ADDR_BUF)
        ld d, a
        ld a, (SD_ADDR_BUF+1)
        ld e, a
        ld a, (SD_ADDR_BUF+2)
        ld b, a
        ld a, (SD_ADDR_BUF+3)
        ld c, a
        call fuzix_sd_set_sector
        call fuzix_sd_read_sector
        
        ld a,(PAGE_CNT)
        dec a
        ld (PAGE_CNT),a
        cp a,0
        ret z
        ld a, (SD_ADDR_BUF+2)
        ld b, a
        ld a, (SD_ADDR_BUF+3)
        ld c, a
        inc bc
        ld a, b
        ld (SD_ADDR_BUF+2), a
        ld a, c
        ld (SD_ADDR_BUF+3), a
        ;ld a, c
        or b
        jr nz,fuzix_sd_boot_loop
        ld a, (SD_ADDR_BUF)
        ld d, a
        ld a, (SD_ADDR_BUF+1)
        ld e, a

        inc de
        ld a, d
        ld (SD_ADDR_BUF), a
        ld a, e
        ld (SD_ADDR_BUF+1),a
        jr fuzix_sd_boot_loop
        
; SD read sector
; Reads full 512 byte sector to the memory address in hl
fuzix_sd_read_sector:
        ; Wait until the SD card is ready
        call fuzix_sd_init

        ; Read strobe
        out (SD_READ),a
       
        ; Wait for read to finsih 
        call fuzix_sd_wait

        ; Copy data to RAM
        ld a,0
        ld d,0
fuzix_sd_read_sector_copy:
        out (SD_PAGE),a
        ld c, SD_DATA
fuzix_sd_read_loop:
        in a,(c)
        ld (hl),a
        inc hl
        inc c
        ld a,c
        cp a,0
        jr nz, fuzix_sd_read_loop
        inc d
        ld a,d
        cp a,4
        jr nz, fuzix_sd_read_sector_copy

        ret

; SD set sector
; Sets the SD card sector
; Expects the sector address in de (msw) and bc (lsw)
fuzix_sd_set_sector:       
        call fuzix_sd_init

        ; Set sector
        ld a,c
        out (SD_ADDR_0),a
        ld a,b
        out (SD_ADDR_1),a
        ld a,e
        out (SD_ADDR_2),a
        ld a,d
        out (SD_ADDR_3),a
        
        ret

fuzix_sd_init:
       ; Set the SD IO bank 
        ld a, IO_SELECT_SD
        out (IO_BANK),a

        ; Fall through
        ; Wait unit SD card is ready
fuzix_sd_wait:
       in a,(SD_BUSY)
       cp a,0
       jr nz, fuzix_sd_wait
       ret 
fuzix_boot_end:
        .dephase
fuzix_boot_size = fuzix_boot_end - fuzix_boot_start

